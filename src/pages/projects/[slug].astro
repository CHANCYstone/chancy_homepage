---
import Base from '../../layouts/Base.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import PixelButton from '../../components/ui/PixelButton.astro';
import PixelBadge from '../../components/ui/PixelBadge.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  const sorted = projects.sort((a, b) => b.data.date.localeCompare(a.data.date));

  return sorted.map((project, i) => ({
    params: { slug: project.id },
    props: {
      project,
      prev: sorted[i + 1] || null,
      next: sorted[i - 1] || null,
    },
  }));
}

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const { project, prev, next } = Astro.props;
const { Content } = await render(project);

const badgeColors: Record<string, 'blue' | 'red' | 'green' | 'yellow'> = {
  code: 'red',
  principles: 'green',
  writing: 'blue',
  quant: 'yellow',
};
---

<Base title={project.data.title}>
  <Header />
  <main class="flex-1">
    <article>
      <div class="mb-[var(--spacing-lg)]">
        <PixelBadge color={badgeColors[project.data.category]}>
          {project.data.category.toUpperCase()}
        </PixelBadge>
        <span class="text-[var(--text-xs)] text-[var(--color-muted)] ml-[var(--spacing-md)]">
          {project.data.date}
        </span>
      </div>

      <h1 class="text-[var(--text-xl)] text-[var(--color-on-neutral)] mb-[var(--spacing-xl)]">
        {project.data.title}
      </h1>

      <div class="prose border-4 border-[var(--color-border)] bg-[var(--color-neutral-surface)] p-[var(--spacing-xl)] shadow-[var(--shadow-pixel)] text-[var(--text-xs)] leading-[2.4] [&_h1]:text-[var(--text-lg)] [&_h1]:text-[var(--color-primary)] [&_h1]:mt-[var(--spacing-xl)] [&_h1]:mb-[var(--spacing-md)] [&_h2]:text-[var(--text-base)] [&_h2]:text-[var(--color-secondary)] [&_h2]:mt-[var(--spacing-xl)] [&_h2]:mb-[var(--spacing-md)] [&_h3]:text-[var(--text-sm)] [&_h3]:text-[var(--color-tertiary)] [&_h3]:mt-[var(--spacing-lg)] [&_h3]:mb-[var(--spacing-sm)] [&_p]:mb-[var(--spacing-md)] [&_ul]:list-disc [&_ul]:pl-[var(--spacing-xl)] [&_ul]:mb-[var(--spacing-md)] [&_ol]:list-decimal [&_ol]:pl-[var(--spacing-xl)] [&_ol]:mb-[var(--spacing-md)] [&_li]:mb-[var(--spacing-xs)] [&_blockquote]:border-l-4 [&_blockquote]:border-[var(--color-accent)] [&_blockquote]:pl-[var(--spacing-md)] [&_blockquote]:text-[var(--color-muted)] [&_blockquote]:my-[var(--spacing-md)] [&_strong]:text-[var(--color-primary)] [&_a]:text-[var(--color-secondary)] [&_a:hover]:text-[var(--color-primary)] [&_hr]:border-[var(--color-muted)] [&_hr]:my-[var(--spacing-xl)] [&_code]:bg-[var(--color-neutral)] [&_code]:border-2 [&_code]:border-[var(--color-border)] [&_code]:px-[5px] [&_code]:py-[2px] [&_code]:text-[var(--text-2xs)] [&_code]:text-[var(--color-secondary)] [&_pre]:bg-[#1A1A1A] [&_pre]:text-[var(--color-neutral-surface)] [&_pre]:border-4 [&_pre]:border-[var(--color-border)] [&_pre]:p-[var(--spacing-md)] [&_pre]:overflow-x-auto [&_pre]:my-[var(--spacing-lg)] [&_pre_code]:bg-transparent [&_pre_code]:border-0 [&_pre_code]:text-inherit [&_pre_code]:p-0">
        <Content />
      </div>
    </article>

    <nav class="flex justify-between mt-[var(--spacing-xl)] gap-[var(--spacing-md)]">
      {prev ? (
        <PixelButton href={`${base}projects/${prev.id}`} variant="secondary">
          ← PREV
        </PixelButton>
      ) : <div />}

      <PixelButton href={`${base}projects`} variant="secondary">
        ← BACK TO DUNGEON
      </PixelButton>

      {next ? (
        <PixelButton href={`${base}projects/${next.id}`} variant="secondary">
          NEXT →
        </PixelButton>
      ) : <div />}
    </nav>
  </main>
  <Footer />
</Base>
