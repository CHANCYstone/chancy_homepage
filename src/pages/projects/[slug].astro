---
import Base from '../../layouts/Base.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import PixelButton from '../../components/ui/PixelButton.astro';
import PixelBadge from '../../components/ui/PixelBadge.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  const sorted = projects.sort((a, b) => b.data.date.localeCompare(a.data.date));

  return sorted.map((project, i) => ({
    params: { slug: project.id },
    props: {
      project,
      prev: sorted[i + 1] || null,
      next: sorted[i - 1] || null,
    },
  }));
}

const { project, prev, next } = Astro.props;
const { Content } = await render(project);

const badgeColors: Record<string, 'blue' | 'red' | 'green' | 'yellow'> = {
  code: 'red',
  principles: 'green',
  writing: 'blue',
  quant: 'yellow',
};
---

<Base title={project.data.title}>
  <Header />
  <main>
    <article>
      <div class="mb-[var(--spacing-lg)]">
        <PixelBadge color={badgeColors[project.data.category]}>
          {project.data.category.toUpperCase()}
        </PixelBadge>
        <span class="text-[0.625rem] text-[var(--color-muted)] ml-[var(--spacing-md)]">
          {project.data.date}
        </span>
      </div>

      <h1 class="text-[1.25rem] text-[var(--color-on-neutral)] mb-[var(--spacing-xl)]">
        {project.data.title}
      </h1>

      <div class="prose border-4 border-[var(--color-border)] bg-[var(--color-neutral-surface)] p-[var(--spacing-xl)] shadow-[var(--shadow-pixel)] text-[0.75rem] leading-[1.8] [&_h1]:text-[1rem] [&_h1]:text-[var(--color-primary)] [&_h1]:mt-[var(--spacing-xl)] [&_h1]:mb-[var(--spacing-md)] [&_h2]:text-[0.875rem] [&_h2]:text-[var(--color-secondary)] [&_h2]:mt-[var(--spacing-lg)] [&_h2]:mb-[var(--spacing-sm)] [&_h3]:text-[0.75rem] [&_h3]:text-[var(--color-tertiary)] [&_h3]:mt-[var(--spacing-md)] [&_h3]:mb-[var(--spacing-sm)] [&_p]:mb-[var(--spacing-md)] [&_ul]:list-disc [&_ul]:pl-[var(--spacing-xl)] [&_ul]:mb-[var(--spacing-md)] [&_ol]:list-decimal [&_ol]:pl-[var(--spacing-xl)] [&_ol]:mb-[var(--spacing-md)] [&_li]:mb-[var(--spacing-xs)] [&_blockquote]:border-l-4 [&_blockquote]:border-[var(--color-accent)] [&_blockquote]:pl-[var(--spacing-md)] [&_blockquote]:text-[var(--color-muted)] [&_blockquote]:my-[var(--spacing-md)] [&_strong]:text-[var(--color-primary)] [&_a]:text-[var(--color-secondary)] [&_a:hover]:text-[var(--color-primary)] [&_hr]:border-[var(--color-muted)] [&_hr]:my-[var(--spacing-xl)]">
        <Content />
      </div>
    </article>

    <nav class="flex justify-between mt-[var(--spacing-xl)] gap-[var(--spacing-md)]">
      {prev ? (
        <PixelButton href={`/projects/${prev.id}`} variant="secondary">
          ← PREV
        </PixelButton>
      ) : <div />}

      <PixelButton href="/projects" variant="secondary">
        ← BACK TO DUNGEON
      </PixelButton>

      {next ? (
        <PixelButton href={`/projects/${next.id}`} variant="secondary">
          NEXT →
        </PixelButton>
      ) : <div />}
    </nav>
  </main>
  <Footer />
</Base>
