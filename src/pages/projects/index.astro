---
import Base from '../../layouts/Base.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import PixelCard from '../../components/ui/PixelCard.astro';
import PixelBadge from '../../components/ui/PixelBadge.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const allProjects = await getCollection('projects');
const sorted = allProjects.sort((a, b) => b.data.date.localeCompare(a.data.date));

const categories = ['all', 'principles', 'writing', 'quant', 'code'] as const;

const badgeColors: Record<string, 'blue' | 'red' | 'green' | 'yellow'> = {
  code: 'red',
  principles: 'green',
  writing: 'blue',
  quant: 'yellow',
};
---

<Base title="Projects">
  <Header />
  <main>
    <h1 class="text-[2rem] text-[var(--color-primary)] mb-[var(--spacing-xl)]">
      PROJECTS
    </h1>

    <div class="flex flex-wrap gap-[var(--spacing-sm)] mb-[var(--spacing-xl)]">
      {categories.map(cat => (
        <button
          data-filter={cat}
          class="filter-btn font-[var(--font-pixel)] bg-[var(--color-neutral)] text-[var(--color-on-neutral)] border-4 border-[var(--color-border)] px-[var(--spacing-md)] py-[var(--spacing-sm)] text-[0.5rem] shadow-[var(--shadow-pixel-sm)] cursor-pointer hover:bg-[var(--color-accent)] hover:text-[var(--color-on-neutral)]"
        >
          {cat.toUpperCase()}
        </button>
      ))}
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-[var(--spacing-md)]" id="projects-grid">
      {sorted.map(project => (
        <div data-category={project.data.category} class="project-item">
          <PixelCard href={`${base}projects/${project.id}`}>
            <div class="mb-[var(--spacing-sm)]">
              <PixelBadge color={badgeColors[project.data.category]}>
                {project.data.category.toUpperCase()}
              </PixelBadge>
            </div>
            <h3 class="text-sm text-[var(--color-on-neutral)] mb-[var(--spacing-sm)]">
              {project.data.title}
            </h3>
            <p class="text-xs text-[var(--color-muted)] mb-[var(--spacing-xs)]">
              {project.data.date}
            </p>
            <p class="text-xs text-[var(--color-on-neutral)] line-clamp-2">
              {project.data.summary}
            </p>
          </PixelCard>
        </div>
      ))}
    </div>
  </main>
  <Footer />
</Base>

<script>
  const buttons = document.querySelectorAll('.filter-btn');
  const items = document.querySelectorAll('.project-item');

  function setActive(activeBtn: Element) {
    buttons.forEach(b => {
      const el = b as HTMLElement;
      el.style.backgroundColor = '';
      el.style.color = '';
      el.style.borderColor = '';
    });
    const el = activeBtn as HTMLElement;
    el.style.backgroundColor = 'var(--color-accent)';
    el.style.borderColor = 'var(--color-border)';
  }

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      const filter = (btn as HTMLElement).dataset.filter;
      items.forEach(item => {
        const el = item as HTMLElement;
        if (filter === 'all' || el.dataset.category === filter) {
          el.style.display = '';
        } else {
          el.style.display = 'none';
        }
      });
      setActive(btn);
    });
  });

  if (buttons.length > 0) setActive(buttons[0]);
</script>
