---
import Base from '../layouts/Base.astro';
import PixelButton from '../components/ui/PixelButton.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<Base title="404">
  <main class="flex flex-col items-center justify-center min-h-[61.8vh] text-center">
    <h1 class="text-[var(--text-4xl)] text-[var(--color-primary)] mb-[var(--spacing-md)]" style="text-shadow: 3px 3px 0 var(--color-border);">
      YOU DIED
    </h1>
    <p class="text-[var(--text-sm)] text-[var(--color-muted)] mb-[var(--spacing-sm)]">
      - 0 HP -
    </p>
    <p class="text-[var(--text-xs)] text-[var(--color-on-neutral)] mb-[var(--spacing-xl)]">
      This page doesn't exist in this world.
    </p>
    <PixelButton href={base}>
      RESPAWN
    </PixelButton>
  </main>
</Base>
