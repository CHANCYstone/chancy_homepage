---
import Base from '../layouts/Base.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

const skills = [
  { category: 'LANGUAGES', icon: '🗡️', items: [
    { name: 'Python', level: 90 },
    { name: 'TypeScript', level: 75 },
    { name: 'SQL', level: 70 },
  ]},
  { category: 'FRAMEWORKS', icon: '🛡️', items: [
    { name: 'Astro', level: 70 },
    { name: 'React', level: 65 },
    { name: 'FastAPI', level: 80 },
  ]},
  { category: 'TOOLS', icon: '🔧', items: [
    { name: 'Git', level: 85 },
    { name: 'Obsidian', level: 90 },
    { name: 'Claude', level: 95 },
  ]},
  { category: 'DOMAINS', icon: '🌟', items: [
    { name: '量化交易', level: 80 },
    { name: 'AI 应用', level: 85 },
    { name: '写作体系', level: 75 },
  ]},
];

const stats = [
  { label: 'CLASS', value: '跨领域开发者' },
  { label: 'MOTTO', value: '做对的事情 把事情做对' },
  { label: 'GUILD', value: 'Solo' },
];
---

<Base title="About">
  <Header />
  <main class="flex-1">
    <h1 class="text-[var(--text-2xl)] text-[var(--color-primary)] mb-[var(--spacing-xl)]" style="text-shadow: 3px 3px 0 var(--color-border);">
      ABOUT
    </h1>

    <section class="border-4 border-[var(--color-border)] bg-[var(--color-neutral-surface)] p-[var(--spacing-xl)] shadow-[var(--shadow-pixel)] mb-[var(--spacing-2xl)]">
      <h2 class="text-[var(--text-lg)] text-[var(--color-secondary)] mb-[var(--spacing-lg)]">
        PLAYER PROFILE
      </h2>

      <div class="flex flex-col gap-[var(--spacing-sm)] mb-[var(--spacing-lg)]">
        {stats.map(stat => (
          <div class="flex items-baseline gap-[var(--spacing-lg)]">
            <span class="text-[var(--text-2xs)] text-[var(--color-accent)] min-w-[55px]">{stat.label}</span>
            <span class="text-[var(--text-xs)] text-[var(--color-on-neutral)]">{stat.value}</span>
          </div>
        ))}
      </div>

      <div class="border-t-2 border-[var(--color-border)] pt-[var(--spacing-md)]">
        <p class="text-[var(--text-xs)] mb-[var(--spacing-md)] leading-[2.4]">
          在量化交易、AI 应用、写作和全栈开发之间切换的跨领域开发者。相信系统化方法论的力量——先想清楚该做什么，再把它做到极致。
        </p>
        <p class="text-[var(--text-xs)] text-[var(--color-muted)] leading-[2.4]">
          这个网站是我的公开知识库——把 Obsidian 里的思考搬到阳光下，倒逼自己整理和输出。
        </p>
      </div>
    </section>

    <section class="mb-[var(--spacing-2xl)]">
      <h2 class="text-[var(--text-xl)] text-[var(--color-on-neutral)] mb-[var(--spacing-xl)]">
        SKILL TREE
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-[var(--spacing-lg)]">
        {skills.map(group => (
          <div class="skill-group border-4 border-[var(--color-border)] bg-[var(--color-neutral-surface)] p-[var(--spacing-lg)] shadow-[var(--shadow-pixel)]">
            <h3 class="text-[var(--text-sm)] text-[var(--color-accent)] mb-[var(--spacing-md)]">
              {group.icon} {group.category}
            </h3>
            <ul class="list-none p-0 m-0">
              {group.items.map(item => (
                <li class="mb-[var(--spacing-md)]">
                  <div class="flex justify-between text-[var(--text-xs)] text-[var(--color-on-neutral)] mb-[3px]">
                    <span>{item.name}</span>
                    <span class="text-[var(--text-2xs)] text-[var(--color-muted)]">Lv.{Math.floor(item.level / 10)}</span>
                  </div>
                  <div class="h-[8px] bg-[var(--color-neutral)] border-2 border-[var(--color-border)]">
                    <div class="h-full bg-[var(--color-tertiary)] skill-bar" style={`width: ${item.level}%`}></div>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
  .skill-group {
    transition: transform 0.1s ease, border-color 0.15s ease;
  }
  .skill-group:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-pixel-hover);
    border-color: var(--color-accent);
  }
  .skill-bar {
    image-rendering: pixelated;
    transition: width 0.6s steps(10);
  }
</style>
