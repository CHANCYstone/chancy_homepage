---
import Base from '../layouts/Base.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import PixelButton from '../components/ui/PixelButton.astro';

const contacts = [
  { label: 'EMAIL', value: 'supperduang@163.com', href: 'mailto:supperduang@163.com' },
  { label: 'GITHUB', value: 'github.com/chancystone', href: 'https://github.com/chancystone' },
];
---

<Base title="Contact">
  <Header />
  <main>
    <h1 class="text-[2rem] text-[var(--color-primary)] mb-[var(--spacing-xl)]">
      CONTACT
    </h1>

    <div class="border-4 border-[var(--color-border)] bg-[var(--color-neutral-surface)] p-[var(--spacing-xl)] shadow-[var(--shadow-pixel)] mb-[var(--spacing-xl)]">
      <p class="text-[0.75rem] text-[var(--color-on-neutral)] mb-[var(--spacing-xl)]">
        想组队？有任务要接？邮件是最快的传送门。
      </p>

      <div class="flex flex-col gap-[var(--spacing-lg)]">
        {contacts.map(contact => (
          <div class="flex flex-col gap-[var(--spacing-sm)]">
            <span class="text-[0.625rem] text-[var(--color-accent)]">
              {contact.label}
            </span>
            <PixelButton href={contact.href} variant="secondary">
              {contact.value}
            </PixelButton>
          </div>
        ))}
      </div>
    </div>
  </main>
  <Footer />
</Base>
