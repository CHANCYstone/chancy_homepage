---
const navItems = [
  { label: 'HOME', href: '/' },
  { label: 'ABOUT', href: '/about' },
  { label: 'PROJECTS', href: '/projects' },
  { label: 'CONTACT', href: '/contact' },
];

const currentPath = Astro.url.pathname;
---

<header class="border-b-4 border-[var(--color-border)] pb-[var(--spacing-md)] mb-[var(--spacing-2xl)]">
  <nav class="flex flex-wrap items-center justify-between gap-[var(--spacing-md)]">
    <a href="/" class="text-[1rem] text-[var(--color-primary)] hover:text-[var(--color-accent)]">
      ChancyStone
    </a>
    <ul class="flex flex-wrap gap-[var(--spacing-lg)] list-none m-0 p-0">
      {navItems.map(item => (
        <li>
          <a
            href={item.href}
            class:list={[
              'text-[0.625rem]',
              currentPath === item.href
                ? 'text-[var(--color-primary)]'
                : 'text-[var(--color-on-neutral)] hover:text-[var(--color-secondary)]',
            ]}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
