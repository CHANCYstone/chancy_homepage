---
import PixelCard from '../ui/PixelCard.astro';
import PixelBadge from '../ui/PixelBadge.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const featured = allProjects
  .filter(p => p.data.featured)
  .sort((a, b) => b.data.date.localeCompare(a.data.date))
  .slice(0, 4);

const badgeColors: Record<string, 'blue' | 'red' | 'green' | 'yellow'> = {
  code: 'red',
  principles: 'green',
  writing: 'blue',
  quant: 'yellow',
};
---

<section class="py-[var(--spacing-2xl)]">
  <h2 class="text-[1.25rem] text-[var(--color-on-neutral)] mb-[var(--spacing-xl)]">
    FEATURED
  </h2>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-[var(--spacing-md)]">
    {featured.map(project => (
      <PixelCard href={`/projects/${project.id}`}>
        <div class="mb-[var(--spacing-sm)]">
          <PixelBadge color={badgeColors[project.data.category]}>
            {project.data.category.toUpperCase()}
          </PixelBadge>
        </div>
        <h3 class="text-[0.75rem] text-[var(--color-on-neutral)] mb-[var(--spacing-sm)]">
          {project.data.title}
        </h3>
        <p class="text-[0.625rem] text-[var(--color-muted)] line-clamp-2">
          {project.data.summary}
        </p>
      </PixelCard>
    ))}
  </div>
</section>
