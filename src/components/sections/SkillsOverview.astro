---
const skills = [
  { name: '量化', icon: '📊', color: 'text-[var(--color-accent)]' },
  { name: 'AI', icon: '🤖', color: 'text-[var(--color-primary)]' },
  { name: '写作', icon: '✍️', color: 'text-[var(--color-tertiary)]' },
  { name: '开发', icon: '⚡', color: 'text-[var(--color-secondary)]' },
];
---

<section class="py-[var(--spacing-2xl)]">
  <h2 class="text-[1.25rem] text-[var(--color-on-neutral)] mb-[var(--spacing-xl)]">
    SKILLS
  </h2>
  <div class="grid grid-cols-2 md:grid-cols-4 gap-[var(--spacing-md)]">
    {skills.map(skill => (
      <div class="border-4 border-[var(--color-border)] bg-[var(--color-neutral-surface)] p-[var(--spacing-lg)] text-center shadow-[var(--shadow-pixel)]">
        <div class="text-[2rem] mb-[var(--spacing-sm)]">{skill.icon}</div>
        <h3 class:list={['text-[0.75rem]', skill.color]}>
          {skill.name}
        </h3>
      </div>
    ))}
  </div>
</section>
