---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary';
  class?: string;
}

const { href, variant = 'primary', class: className = '' } = Astro.props;

const Tag = href ? 'a' : 'button';

const baseClass = 'pixel-btn inline-block text-[var(--text-xs)] px-[var(--spacing-lg)] py-[var(--spacing-md)] border-4 border-[var(--color-border)] cursor-pointer transition-transform duration-100';

const variants = {
  primary: 'bg-[var(--color-primary)] text-[var(--color-on-primary)] shadow-[var(--shadow-pixel)] hover:bg-[var(--color-accent)] hover:text-[var(--color-on-neutral)] hover:shadow-[var(--shadow-pixel-hover)]',
  secondary: 'bg-[var(--color-neutral)] text-[var(--color-on-neutral)] shadow-[var(--shadow-pixel)] hover:bg-[var(--color-neutral-surface)] hover:shadow-[var(--shadow-pixel-hover)]',
};
---

<Tag href={href} class:list={[baseClass, variants[variant], className]}>
  <slot />
</Tag>

<style>
  .pixel-btn:active {
    transform: translate(2px, 2px);
    box-shadow: 1px 1px 0 var(--color-border) !important;
  }
</style>
