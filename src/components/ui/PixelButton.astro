---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary';
  class?: string;
}

const { href, variant = 'primary', class: className = '' } = Astro.props;

const Tag = href ? 'a' : 'button';

const base = 'inline-block text-[0.75rem] font-[var(--font-pixel)] px-[var(--spacing-lg)] py-[var(--spacing-md)] border-4 border-[var(--color-border)] cursor-pointer';

const variants = {
  primary: 'bg-[var(--color-primary)] text-[var(--color-on-primary)] shadow-[var(--shadow-pixel)] hover:bg-[var(--color-accent)] hover:text-[var(--color-on-neutral)] hover:shadow-[var(--shadow-pixel-hover)]',
  secondary: 'bg-[var(--color-neutral)] text-[var(--color-on-neutral)] shadow-[var(--shadow-pixel)] hover:bg-[var(--color-neutral-surface)] hover:shadow-[var(--shadow-pixel-hover)]',
};
---

<Tag href={href} class:list={[base, variants[variant], className]}>
  <slot />
</Tag>
